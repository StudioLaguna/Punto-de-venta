{
  "name": "pos-basico",
  "version": "1.0.0",
  "description": "POS básico: ventas + inventario, offline, una caja (Electron + React + SQLite)",
  "main": "dist/main/main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"tsc -p tsconfig.main.json && electron .\"",
    "dev:web": "vite --port 5173",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dist": "npm run build && electron-builder --win",
    "lint": "eslint src tests --ext .ts,.tsx",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^35.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  },
  "author": "POS Básico",
  "build": {
    "appId": "com.pos.basico",
    "productName": "POS Básico",
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "migrations/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
